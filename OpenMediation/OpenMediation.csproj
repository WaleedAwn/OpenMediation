<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <!-- Essential for .NET 10 features like params ReadOnlySpan -->
	  <LangVersion>preview</LangVersion>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  
	  <!-- Quality Control -->
	  <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
	  
	  <!-- Package Metadata for NuGet and GitHub -->
	  <PackageId>OpenMediation</PackageId>
	  <Version>1.0.0</Version>
	  <Authors>WaleedAwn</Authors>
	  <Company>SSFVision</Company>
	  <Description>
		  A high-performance, production-ready Mediator pattern implementation for .NET 10.
		  Features compiled expression-tree dispatch, optimized pipeline behavior support,
		  and zero dynamic-dispatch overhead.
	  </Description>
	  <PackageTags>mediator;cqrs;pipeline;notifications;dotnet;high-performance</PackageTags>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  
	  <!-- This links  README to the NuGet page -->
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryUrl>https://github.com/WaleedAwn/OpenMediation.git</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/WaleedAwn/OpenMediation</PackageProjectUrl>
	  
	  <!-- Deterministic builds make debugging easier for others -->
	  <Deterministic>true</Deterministic>
	  <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
	
	<ItemGroup>
		<!-- Use the stable-match version for .NET 10 -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0-preview.1.25080.5" />
	</ItemGroup>
	
	<!-- This tells NuGet to include your README file in the package -->
	<ItemGroup Condition="Exists('README.md')">
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
